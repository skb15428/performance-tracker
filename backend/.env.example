# Local single-user setup uses SQLite (backend/goalcoach.db) when DATABASE_URL is unset.
# DATABASE_URL=postgresql+asyncpg://goalcoach:goalcoach@localhost:5432/goalcoach
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
CORS_ORIGINS=["http://localhost:5173"]

JOBS_SECRET=replace-with-another-random-string

# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Account the local MCP server (Claude Desktop) acts as
OWNER_EMAIL=me@example.com

# Cloud only: public URL of this API. Enables the remote MCP endpoint ({PUBLIC_URL}/mcp) with OAuth.
PUBLIC_URL=

# Nightly email reminder (optional). Resend's default sender delivers only to the Resend account's own address.
RESEND_API_KEY=
